{
  "name": "henteplan",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "bunx biome check src/",
    "classifier:apply": "bun run src/fractions/cli.ts apply",
    "classifier:pending": "bun run src/fractions/cli.ts pending",
    "classifier:scan": "bun run src/fractions/cli.ts scan",
    "dev": "bun run --hot src/index.ts",
    "fix": "bunx biome check --fix src/",
    "start": "bun run src/index.ts",
    "test": "bun test src/tests/unit src/tests/integration",
    "test:all": "bun test src/tests --timeout 360000",
    "test:smoke": "bun test src/tests/e2e --timeout 360000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "@scalar/hono-api-reference": "^0.12.0",
    "hono": "^4.13.5",
    "hono-rate-limiter": "^0.5.3",
    "ical-generator": "^11.1.1",
    "node-html-parser": "^7.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "ultracite": "^7.10.7"
  }
}
